# Copy to .env in the repo root and fill in your values.

# Telegram — from @BotFather after /newbot (bot only; not needed for UI server)
TELEGRAM_BOT_TOKEN=

# OpenRouter — from https://openrouter.ai/keys
# Enables smarter natural-language parsing in the UI (Home chat) and Telegram bot
# when built-in rules don't match. Without it, rules-only mode still works.
OPENROUTER_API_KEY=

# Optional: override the default cheap model
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# Optional: database locations
# DATABASE_PATH=data/domus.db          # Telegram bot
# DOMUS_UI_DB=data/domus_ui.db         # Web UI (ui/server.py)

# Optional: hour for automatic morning briefing (local time, 24h)
# BRIEFING_HOUR=8

# Optional: hour for automatic evening summary (local time, 24h)
# EVENING_BRIEFING_HOUR=20

# Quiet hours — defer reminder pushes (local time, 24h). Default: 22:00–07:00
# QUIET_HOURS_ENABLED=true
# QUIET_HOURS_START=22
# QUIET_HOURS_END=7

# Optional: disable UI chat log files (default: on → logs/ui/session_*.log)
# DOMUS_CHAT_LOG=false
# REDACTION_ENABLED=false
# REDACTION_PATTERNS=Sebastian|\d+\s*€
